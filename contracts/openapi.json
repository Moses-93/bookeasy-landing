{
    "openapi": "3.1.0",
    "info": {
        "title": "BOOKEASY",
        "summary": "REST API for appointment booking and master/client management",
        "description": "BookEasy REST API for beauty-service booking. Includes auth (email/password and Google), public booking flows, client and master booking management, master profile/services/time-slots/statistics, billing/subscription, shared booking utilities, Telegram integration, and payment webhooks.",
        "termsOfService": "https://bookeasy.com.ua/terms",
        "contact": {
            "name": "BookEasy Support",
            "url": "https://bookeasy.com.ua/",
            "email": "bookeasy.ua@gmail.com"
        },
        "version": "2.1.0"
    },
    "servers": [
        {
            "url": "https://api.bookeasy.com.ua",
            "description": "prod environment"
        }
    ],
    "paths": {
        "/api/v1/masters/{master_token}/public-profile": {
            "get": {
                "tags": [
                    "public:masters"
                ],
                "summary": "Get Public Master Profile",
                "operationId": "get_public_master_profile_api_v1_masters__master_token__public_profile_get",
                "parameters": [
                    {
                        "name": "master_token",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Master invite token",
                            "examples": [
                                "A3E2-25CB-D794"
                            ],
                            "title": "Master Token"
                        },
                        "description": "Master invite token"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PublicMasterProfileSchema"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Master not found"
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error: Unexpected system failure"
                    }
                }
            }
        },
        "/api/v1/services": {
            "get": {
                "tags": [
                    "public:services"
                ],
                "summary": "List Services",
                "operationId": "list_services_api_v1_services_get",
                "parameters": [
                    {
                        "name": "master_id",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "description": "Unique identifier of the service provider",
                            "examples": [
                                10
                            ],
                            "title": "Master Id"
                        },
                        "description": "Unique identifier of the service provider"
                    },
                    {
                        "name": "is_active",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "boolean",
                            "description": "Filter by status. If None, returns active only.",
                            "default": true,
                            "title": "Is Active"
                        },
                        "description": "Filter by status. If None, returns active only."
                    },
                    {
                        "name": "min_price",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "anyOf": [
                                {
                                    "type": "integer",
                                    "exclusiveMinimum": 0,
                                    "description": "Service price in minor units (cents/kopecks)",
                                    "examples": [
                                        5000
                                    ]
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Lower price bound",
                            "title": "Min Price"
                        },
                        "description": "Lower price bound"
                    },
                    {
                        "name": "max_price",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "anyOf": [
                                {
                                    "type": "integer",
                                    "exclusiveMinimum": 0,
                                    "description": "Service price in minor units (cents/kopecks)",
                                    "examples": [
                                        5000
                                    ]
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Upper price bound",
                            "title": "Max Price"
                        },
                        "description": "Upper price bound"
                    },
                    {
                        "name": "min_duration",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "anyOf": [
                                {
                                    "type": "string",
                                    "format": "duration",
                                    "description": "Duration in ISO 8601 format (e.g., PT30M for 30 mins)",
                                    "examples": [
                                        "PT30M"
                                    ]
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Minimum duration limit",
                            "title": "Min Duration"
                        },
                        "description": "Minimum duration limit"
                    },
                    {
                        "name": "max_duration",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "anyOf": [
                                {
                                    "type": "string",
                                    "format": "duration",
                                    "description": "Duration in ISO 8601 format (e.g., PT30M for 30 mins)",
                                    "examples": [
                                        "PT30M"
                                    ]
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Maximum duration limit",
                            "title": "Max Duration"
                        },
                        "description": "Maximum duration limit"
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "maximum": 100,
                            "minimum": 1,
                            "description": "Maximum number of items to return",
                            "examples": [
                                20
                            ],
                            "default": 10,
                            "title": "Limit"
                        },
                        "description": "Maximum number of items to return"
                    },
                    {
                        "name": "offset",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Number of items to skip",
                            "examples": [
                                0
                            ],
                            "default": 0,
                            "title": "Offset"
                        },
                        "description": "Number of items to skip"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PaginatedResponse_ResponseServiceSchema_"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request: Invalid filter parameters"
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error: Unexpected system failure"
                    }
                }
            }
        },
        "/api/v1/time-slots/available-dates": {
            "get": {
                "tags": [
                    "public:time-slots"
                ],
                "summary": "Get available dates for a master",
                "description": "Retrieve all unique dates that have at least one available time slot.",
                "operationId": "list_available_dates_api_v1_time_slots_available_dates_get",
                "parameters": [
                    {
                        "name": "master_id",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "description": "Master identifier",
                            "title": "Master Id"
                        },
                        "description": "Master identifier"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "type": "string",
                                        "format": "date"
                                    },
                                    "title": "Response List Available Dates Api V1 Time Slots Available Dates Get"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found: No available dates found for the given master"
                    },
                    "422": {
                        "description": "Unprocessable Content: Invalid query parameters"
                    },
                    "500": {
                        "description": "Internal Server Error: Unexpected system failure"
                    }
                }
            }
        },
        "/api/v1/time-slots/bookable": {
            "get": {
                "tags": [
                    "public:time-slots"
                ],
                "summary": "List Bookable Slots",
                "operationId": "list_bookable_slots_api_v1_time_slots_bookable_get",
                "parameters": [
                    {
                        "name": "master_id",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "description": "Master identifier",
                            "title": "Master Id"
                        },
                        "description": "Master identifier"
                    },
                    {
                        "name": "duration",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "duration",
                            "description": "Service duration (e.g., PT30M for 30 minutes)",
                            "examples": [
                                "PT30M"
                            ],
                            "title": "Duration"
                        },
                        "description": "Service duration (e.g., PT30M for 30 minutes)"
                    },
                    {
                        "name": "start_date",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "anyOf": [
                                {
                                    "type": "string",
                                    "format": "date"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Filter slots starting from this date (inclusive)",
                            "examples": [
                                "2026-01-01"
                            ],
                            "title": "Start Date"
                        },
                        "description": "Filter slots starting from this date (inclusive)"
                    },
                    {
                        "name": "on_date",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "anyOf": [
                                {
                                    "type": "string",
                                    "format": "date"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Filter slots by specific date",
                            "examples": [
                                "2026-01-01"
                            ],
                            "title": "On Date"
                        },
                        "description": "Filter slots by specific date"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/BookableTimeSlotSchema"
                                    },
                                    "title": "Response List Bookable Slots Api V1 Time Slots Bookable Get"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found: No available slots found for the given criteria"
                    },
                    "422": {
                        "description": "Unprocessable Content: Invalid query parameters (structural)"
                    },
                    "500": {
                        "description": "Internal Server Error: Unexpected system failure"
                    }
                }
            }
        },
        "/api/v1/bookings/anonymous": {
            "post": {
                "tags": [
                    "public:bookings"
                ],
                "summary": "Make Anonymous Booking",
                "operationId": "make_anonymous_booking_api_v1_bookings_anonymous_post",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateAnonymousBookingSchema"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ResponseBookingSchema"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Master, time slot, or service does not exist"
                    },
                    "409": {
                        "description": "Client with this phone number already exists"
                    },
                    "422": {
                        "description": "Slot is unavailable, in the past, or client is blocked"
                    },
                    "500": {
                        "description": "Internal Server Error: Unexpected system failure"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "PublicMasterProfileSchema": {
                "properties": {
                    "master_id": {
                        "type": "integer",
                        "title": "Master Id",
                        "description": "Master's unique identifier"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "description": "Master's full name"
                    },
                    "contact": {
                        "$ref": "#/components/schemas/ContactSchema",
                        "description": "Master's public contact information"
                    },
                    "online_booking": {
                        "type": "boolean",
                        "title": "Online Booking",
                        "description": "Whether online booking is enabled for the master"
                    },
                    "avatar_url": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Avatar Url",
                        "description": "URL of the master's avatar"
                    },
                    "cover_url": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Cover Url",
                        "description": "URL of the master's cover/palette"
                    },
                    "portfolio": {
                        "items": {
                            "$ref": "#/components/schemas/PhotoSchema"
                        },
                        "type": "array",
