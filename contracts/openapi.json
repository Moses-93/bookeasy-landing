                "properties": {
                    "master_id": {
                        "type": "integer",
                        "minimum": 1,
                        "title": "Master Id",
                        "description": "Unique identifier of the master",
                        "examples": [
                            1
                        ]
                    },
                    "service_id": {
                        "type": "integer",
                        "minimum": 1,
                        "title": "Service Id",
                        "description": "Unique identifier of the service",
                        "examples": [
