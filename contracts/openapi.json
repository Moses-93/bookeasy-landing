                            }
                        ],
                        "title": "Email",
                        "description": "Client's email address"
                    },
                    "instagram_username": {
                        "anyOf": [
                            {
                                "type": "string",
                                "maxLength": 30,
                                "minLength": 1
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Instagram Username",
                        "description": "Client's instagram username"
                    },
                    "telegram_username": {
                        "anyOf": [
                            {
                                "type": "string",
                                "maxLength": 32,
                                "minLength": 5
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Telegram Username",
                        "description": "Client's telegram username"
                    }
                },
