                    },
                    "google_maps_link": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Google Maps Link",
                        "description": "Google Maps location link"
                    },
                    "phone_number": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Phone Number",
                        "description": "Phone number"
                    },
                    "has_telegram": {
                        "type": "boolean",
                        "title": "Has Telegram",
                        "default": false
                    }
                },
                "type": "object",
                "title": "ContactSchema"
            },
            "PhotoSchema": {
                "properties": {
                    "photo_id": {
                        "type": "integer",
