                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            },
            "PaginatedResponse_ResponseServiceSchema_": {
                "properties": {
                    "items": {
                        "items": {
                            "$ref": "#/components/schemas/ResponseServiceSchema"
                        },
                        "type": "array",
                        "title": "Items",
                        "description": "List of resources"
                    },
                    "pagination": {
                        "$ref": "#/components/schemas/Pagination"
                    }
                },
                "type": "object",
                "required": [
                    "items",
                    "pagination"
                ],
                "title": "PaginatedResponse[ResponseServiceSchema]"
            },
            "ResponseServiceSchema": {
                "properties": {
                    "title": {
                        "type": "string",
                        "maxLength": 50,
                        "minLength": 3,
                        "title": "Title",
                        "description": "Service display name",
                        "examples": [
                            "Ламінування брів"
                        ]
                    },
                    "price": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "title": "Price",
                        "description": "Service price in minor units (cents/kopecks)",
                        "examples": [
                            5000
                        ]
                    },
                    "duration": {
                        "type": "string",
                        "format": "duration",
                        "title": "Duration",
                        "description": "Duration in ISO 8601 format (e.g., PT30M for 30 mins)",
                        "examples": [
                            "PT30M"
                        ]
                    },
                    "description": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Description",
                        "description": "Optional detailed description of the service"
                    },
                    "color": {
                        "anyOf": [
                            {
                                "type": "string",
                                "pattern": "^#(?:[0-9A-Fa-f]{3}){1,2}$",
                                "description": "HEX color code (e.g., #BE123C)",
                                "examples": [
                                    "#BE123C"
                                ]
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Color",
                        "description": "Optional HEX color code for branding/identification",
                        "examples": [
                            "#BE123C"
                        ]
                    },
                    "id": {
                        "type": "integer",
                        "title": "Id",
                        "description": "Unique database identifier"
                    },
                    "master_id": {
                        "type": "integer",
                        "title": "Master Id",
                        "description": "Unique identifier of the service provider"
                    },
                    "is_active": {
                        "type": "boolean",
                        "title": "Is Active",
                        "description": "Whether the service is active",
                        "default": true
                    }
                },
                "type": "object",
                "required": [
                    "title",
                    "price",
                    "duration",
                    "id",
                    "master_id"
                ],
                "title": "ResponseServiceSchema",
                "description": "Schema for serializing service data in API responses."
            },
            "Pagination": {
                "properties": {
                    "limit": {
                        "type": "integer",
                        "maximum": 100,
                        "minimum": 1,
                        "title": "Limit",
                        "description": "Maximum number of items returned in the response",
                        "examples": [
                            10
                        ]
                    },
                    "offset": {
                        "type": "integer",
                        "minimum": 0,
                        "title": "Offset",
                        "description": "Number of items skipped from the beginning",
                        "examples": [
                            0
                        ]
                    },
                    "has_next": {
                        "type": "boolean",
                        "title": "Has Next",
                        "description": "Indicates if more items are available",
                        "examples": [
                            true
                        ]
                    }
                },
                "type": "object",
                "required": [
                    "limit",
                    "offset",
                    "has_next"
                ],
                "title": "Pagination"
            },
            "BookableTimeSlotSchema": {
                "properties": {
                    "start_time": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Start Time",
                        "description": "Start time of the booking slot",
                        "examples": [
                            "2026-08-15T13:00:00.000000"
                        ]
                    },
                    "group_ids": {
                        "items": {
                            "type": "integer"
                        },
                        "type": "array",
