{
  "name": "bookeasy-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b",
    "api:fetch": "dotenv -e .env.local -- sh -c 'redocly bundle \"${OPENAPI_URL:-$API_URL/openapi.json}\" -o contracts/openapi.json'",
    "api:types": "openapi-typescript contracts/openapi.json -o src/lib/api/schema.d.ts",
    "api:sync": "npm run api:fetch && npm run api:types"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.5.1",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-number-format": "^5.4.5",
    "use-detect-keyboard-open": "^0.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@redocly/cli": "^2.78.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv-cli": "^11.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  }
}
